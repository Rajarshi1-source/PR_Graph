# PRGraph environment — copy to .env.local (dev) / .env (docker) and fill in.

# App
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Core infrastructure (defaults match docker-compose)
DATABASE_URL=postgresql://prgraph:prgraph@localhost:5432/prgraph?schema=public
REDIS_URL=redis://localhost:6379

# Session + crypto
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# base64-encoded 32 random bytes: `openssl rand -base64 32`
ENCRYPTION_KEY=

# GitHub App (https://github.com/settings/apps) + OAuth
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# App URL handle (e.g. "prgraph") used to build the install link on the dashboard. Optional.
GITHUB_APP_SLUG=

# Slack (optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Grafana admin password (docker-compose monitoring profile). Optional.
GRAFANA_PASSWORD=admin

# AI semantic-conflict layer (Phase 2 — off by default; deterministic heuristic fallback).
# To enable: (1) set OPENAI_API_KEY, (2) run `npm run eval` and confirm F1 >= 0.80 with AI_ENABLED=true,
# (3) flip AI_ENABLED=true. On any LLM error/timeout or once the daily budget is hit, the engine
# silently degrades to the deterministic graph — the graph is always shippable without AI.
AI_ENABLED=false
LLM_PROVIDER=openai:gpt-5.4-mini   # vendor:model — swap providers without code changes
OPENAI_API_KEY=
LLM_DAILY_BUDGET_USD=5             # 0 = unlimited; budget breaker trips at this daily spend
# Second / local providers for the model-swap eval (LLM_PROVIDER=anthropic:<model> | ollama:<model>).
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Phase 3 — Tier-2 merge simulation: replay git's merge with diff3 for approximate edges
# (fetches file blobs; immutable, cached by SHA). Capped per recompute.
MERGE_SIM_DEEP=true
MERGE_SIM_MAX_PAIRS=20

# Process role (SCALING.md §2): all | web | worker.
PROCESS_ROLE=all

# Public /demo page + demo preflight (static fixtures only). Defaults to true outside production.
DEMO_ENABLED=true

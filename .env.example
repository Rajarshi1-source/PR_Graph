# PRGraph environment — copy to .env.local (dev) / .env (docker) and fill in.

# App
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Core infrastructure (defaults match docker-compose)
DATABASE_URL=postgresql://prgraph:prgraph@localhost:5432/prgraph?schema=public
REDIS_URL=redis://localhost:6379

# Session + crypto
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# base64-encoded 32 random bytes: `openssl rand -base64 32`
ENCRYPTION_KEY=

# GitHub App (https://github.com/settings/apps) + OAuth
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# App URL handle (e.g. "prgraph") used to build the install link on the dashboard. Optional.
GITHUB_APP_SLUG=

# Slack (optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Grafana admin password (docker-compose monitoring profile). Optional.
GRAFANA_PASSWORD=admin

# AI semantic-conflict layer (Phase 2 — off by default; heuristic fallback)
AI_ENABLED=false
LLM_PROVIDER=openai:gpt-5.4-mini
OPENAI_API_KEY=
LLM_DAILY_BUDGET_USD=5

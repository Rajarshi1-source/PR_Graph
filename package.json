{
  "name": "prgraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/websocket.ts",
    "dev:next": "next dev",
    "build": "next build",
    "build:server": "esbuild server/websocket.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "e2e": "playwright test --grep-invert @screenshots",
    "screenshots": "playwright test --grep @screenshots --workers=1",
    "eval": "tsx evals/conflict.eval.ts",
    "eval:ci": "tsx evals/conflict.eval.ts --ci",
    "eval:baseline": "tsx evals/conflict.eval.ts --save-baseline",
    "eval:impact": "tsx evals/impact.eval.ts",
    "eval:impact:ci": "tsx evals/impact.eval.ts --ci",
    "eval:impact:baseline": "tsx evals/impact.eval.ts --save-baseline",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@octokit/auth-app": "^8.3.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@slack/web-api": "^7.17.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "html-to-image": "1.11.13",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "node-diff3": "^3.2.1",
    "octokit": "^5.0.5",
    "openai": "^6.44.0",
    "opossum": "^9.0.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "axios": "^1.20.0",
    "baseline-browser-mapping": "^2.11.29",
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^5": "^5.0.12",
    "browserslist": "^4.29.3",
    "engine.io": "^6.6.11",
    "js-yaml@^4": "^4.3.2",
    "socket.io-parser": "^4.2.7"
  }
}
